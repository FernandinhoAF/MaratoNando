# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Token do bot (Discord Developer Portal → sua aplicação → Bot → Reset Token)
DISCORD_TOKEN=cole_o_token_aqui

# Opcional: ID do servidor de testes. Com ele, os comandos aparecem na hora nesse servidor.
# Deixe vazio em produção (Discloud).
DEV_GUILD_ID=

# Radar de jogos (opcional): chaves de uma aplicação em https://dev.twitch.tv/console
# Sem elas, o bot funciona normalmente, só o radar fica desligado.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Steam (opcional): chave em https://steamcommunity.com/dev/apikey
# Usada pelo /steam vincular e pelo /maratona baratos. Sem ela, só essas partes ficam desligadas.
STEAM_API_KEY=

# Opcional: link "raw" da pasta assets no GitHub, para o Nando certinho (sorrindo/surpreso) no canto dos embeds.
# Ex.: https://raw.githubusercontent.com/SEU_USUARIO/MaratoNando/main/assets
# Vazio = usa o avatar do bot no lugar (que também é o Nando).
MARCA_URL=

# Opcional: onde salvar o banco de dados
DB_PATH=maratonando.db
